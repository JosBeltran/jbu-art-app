import { NextResponse } from 'next/server'
import { createClient } from '@supabase/supabase-js'

// Inicializamos el cliente de Supabase con permisos de Service Role (Server-side)
const supabaseAdmin = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY
)

export async function GET(request, { params }) {
  try {
    const { id } = await params

    if (!id) {
      return NextResponse.json(
        { error: 'ID de orden no proporcionado' },
        { status: 400 }
      )
    }

    // 1. Consultar la cabecera de la orden
    const { data: order, error: orderError } = await supabaseAdmin
      .from('orders')
      .select('*')
      .eq('id', id)
      .single()

    if (orderError || !order) {
      return NextResponse.json(
        { error: 'No se encontró la orden especificada' },
        { status: 404 }
      )
    }

    // 2. Consultar los ítems comprados (con sus relaciones de grupo y artwork)
    const { data: items, error: itemsError } = await supabaseAdmin
      .from('order_items')
      .select(`
        *,
        claim_groups ( group_token ),
        artworks ( sku, primary_image_url, is_claimed, is_transferred )
      `)
      .eq('order_id', id)

    if (itemsError) {
      return NextResponse.json(
        { error: 'Error al consultar los ítems de la orden' },
        { status: 500 }
      )
    }

    // 3. Retornar la respuesta estructurada
    return NextResponse.json({
      order,
      items: items || []
    })

  } catch (error) {
    return NextResponse.json(
      { error: error.message || 'Error interno del servidor' },
      { status: 500 }
    )
  }
}